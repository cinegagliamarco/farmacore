NODE_ENV=development
PORT=3000
WORKER_MODE=0
DATABASE_URL=postgres://app:app@localhost:5433/app
DATABASE_DIRECT_URL=postgres://app:app@localhost:5433/app
AMQP_URL=amqp://guest:guest@localhost:5673
JWT_SECRET=replace-me-with-at-least-32-characters
INTEGRATION_DB_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=local
R2_SECRET_ACCESS_KEY=local
R2_BUCKET=farmacore-dev
R2_KEY_PREFIX=dev/
# Optional: public base URL for re-hosted images. Falls back to R2_ENDPOINT/R2_BUCKET when unset.
# R2_PUBLIC_DOMAIN=https://product-images.macfarma.com.br

# Observability (all optional in dev)
OTEL_DISABLED=1
OTEL_SERVICE_NAME=farmacore-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# RabbitMQ management API (queue depth poller). Local: http://localhost:15673/api guest/guest
AMQP_MGMT_URL=
AMQP_MGMT_USER=
AMQP_MGMT_PASS=
# Legacy aliases (still read when AMQP_MGMT_* unset)
CLOUDAMQP_API_URL=
CLOUDAMQP_API_USER=
CLOUDAMQP_API_PASS=

# Pipeline import — EANs per batch message (VTEX origins). Set to 1 for legacy 1-EAN/msg.
PIPELINE_IMPORT_VTEX_EAN_BATCH_SIZE=25
PIPELINE_IMPORT_NON_VTEX_EAN_BATCH_SIZE=1

# Dispatch resilience — checkpoint every N publishes; outbox staging for batch emit
PIPELINE_DISPATCH_PUBLISH_CHECKPOINT=1000
# PIPELINE_DISPATCH_OUTBOX_PUBLISH=1

# Publish timeout for dispatch/outbox drain (0 = no confirm timeout; API keeps 30s default)
# PIPELINE_PUBLISH_TIMEOUT_MS=0
PIPELINE_OUTBOX_PUBLISHER_BATCH_SIZE=500
