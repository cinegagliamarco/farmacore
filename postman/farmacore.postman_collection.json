{
  "info": {
    "_postman_id": "00000000-0000-4000-8000-000000000001",
    "name": "Farmacore",
    "description": "HTTP surface for the Farmacore API. Kept in sync with `plans/` — every plan that touches a controller updates this file. Use the `baseUrl` and `tenantSlug` collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "tenantSlug", "value": "macfarma" },
    { "key": "step", "value": "sync-base-product" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Public liveness endpoint. Returns `{ \"status\": \"ok\" }`. Defined in `src/health/health.controller.ts` (Plan 00 / 07). Marked @Public() so the global JwtAuthGuard does not block it."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Plan 02 — `src/auth/auth.controller.ts`. Login, refresh, logout, and current user.",
      "item": [
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@system.local\",\n  \"password\": \"changeme-please-32-chars-or-more\",\n  \"tenantSlug\": \"system\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Returns `{ accessToken, refreshToken, expiresIn }`. The test script stores both tokens as collection variables for subsequent requests."
          },
          "response": []
        },
        {
          "name": "POST /auth/refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "description": "Rotates the refresh token; returns new `{ accessToken, refreshToken, expiresIn }`."
          },
          "response": []
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] },
            "description": "Returns the decoded JwtPayload (`sub`, `tenantId`, `role`). Bearer token required."
          },
          "response": []
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "description": "Revokes the current user's outstanding refresh tokens. 204 No Content on success."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin — Tenants",
      "description": "Plan 06 — `src/admin/controllers/tenants.controller.ts`. All routes require a token whose tenantId === 'system' and role === 'admin' (SystemAdminGuard).",
      "item": [
        {
          "name": "POST /admin/tenants",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"acme\",\n  \"name\": \"Acme\",\n  \"adminEmail\": \"admin@acme.test\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/tenants", "host": ["{{baseUrl}}"], "path": ["admin", "tenants"] },
            "description": "Onboards a tenant: writes core.tenant row, creates the schema, runs tenant template migrations, seeds tenant_competitor_origin rows, and creates an initial admin user with a one-time random password. Returns `{ slug, schemaName, initialAdminUser: { email, oneTimePassword } }`."
          },
          "response": []
        },
        {
          "name": "GET /admin/tenants",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/tenants", "host": ["{{baseUrl}}"], "path": ["admin", "tenants"] },
            "description": "Lists all tenants ordered by slug."
          },
          "response": []
        },
        {
          "name": "GET /admin/tenants/:slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/tenants/{{tenantSlug}}", "host": ["{{baseUrl}}"], "path": ["admin", "tenants", "{{tenantSlug}}"] },
            "description": "Returns one tenant row by slug. 404 if not found."
          },
          "response": []
        },
        {
          "name": "PATCH /admin/tenants/:slug/status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"paused\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/tenants/{{tenantSlug}}/status", "host": ["{{baseUrl}}"], "path": ["admin", "tenants", "{{tenantSlug}}", "status"] },
            "description": "Changes status. One of `active | paused | suspended`."
          },
          "response": []
        },
        {
          "name": "DELETE /admin/tenants/:slug",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/tenants/{{tenantSlug}}", "host": ["{{baseUrl}}"], "path": ["admin", "tenants", "{{tenantSlug}}"] },
            "description": "Soft-delete: sets `status=suspended` and stamps `deleted_at`. The 30-day grace + R2 dump + schema drop is a follow-up (see Plan 06 open questions)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin — Integration",
      "description": "Plan 06 — `src/admin/controllers/integration.controller.ts`. Wraps Plan 03's `IntegrationConnectionService`.",
      "item": [
        {
          "name": "PUT /admin/tenants/:slug/integration",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": \"a7pharma\",\n  \"name\": \"ERP\",\n  \"host\": \"localhost\",\n  \"port\": 5435,\n  \"database\": \"erp\",\n  \"username\": \"erp\",\n  \"password\": \"erp\",\n  \"sslMode\": \"disable\",\n  \"readOnly\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/tenants/{{tenantSlug}}/integration", "host": ["{{baseUrl}}"], "path": ["admin", "tenants", "{{tenantSlug}}", "integration"] },
            "description": "Upserts the tenant's ERP connection. `origin` selects the vendor entity set (v1: `a7pharma`). Password is encrypted with AES-256-GCM via CredentialEncryptionService. Invalidates the per-tenant DataSource cache. Returns `{ status }`."
          },
          "response": []
        },
        {
          "name": "POST /admin/tenants/:slug/integration/test",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/tenants/{{tenantSlug}}/integration/test", "host": ["{{baseUrl}}"], "path": ["admin", "tenants", "{{tenantSlug}}", "integration", "test"] },
            "description": "Connects to the stored ERP and runs `SELECT 1`. Persists `last_verified_at` on success or `last_error` on failure. Returns `{ ok: true }` or `{ ok: false, error }`."
          },
          "response": []
        },
        {
          "name": "DELETE /admin/tenants/:slug/integration",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/tenants/{{tenantSlug}}/integration", "host": ["{{baseUrl}}"], "path": ["admin", "tenants", "{{tenantSlug}}", "integration"] },
            "description": "Marks the connection `status=disabled` and invalidates the cache."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin — Competitor origins",
      "description": "Plan 06 — `src/admin/controllers/competitor-origins.controller.ts`. Bulk update of `tenant_competitor_origin` rows in the tenant's schema.",
      "item": [
        {
          "name": "PUT /admin/tenants/:slug/competitor-origins",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origins\": [\n    { \"origin\": \"DROGAL\", \"enabled\": true, \"priority\": 100 },\n    { \"origin\": \"DROGASIL\", \"enabled\": true, \"priority\": 50 },\n    { \"origin\": \"MICHELASSI\", \"enabled\": true, \"priority\": 10 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/tenants/{{tenantSlug}}/competitor-origins", "host": ["{{baseUrl}}"], "path": ["admin", "tenants", "{{tenantSlug}}", "competitor-origins"] },
            "description": "Each entry has `{ origin, enabled, priority?, config? }`. Runs inside the tenant schema's transaction (search_path set)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin — Pipeline",
      "description": "Plan 06 — `src/admin/controllers/pipeline.controller.ts`. Triggers the full pipeline run or a single routine.",
      "item": [
        {
          "name": "POST /admin/tenants/:slug/pipeline/start",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/tenants/{{tenantSlug}}/pipeline/start", "host": ["{{baseUrl}}"], "path": ["admin", "tenants", "{{tenantSlug}}", "pipeline", "start"] },
            "description": "Publishes a `pipeline.start` AMQP message for the tenant — runs the WHOLE step graph, chaining successors. Returns `{ pipelineRunId }`. Track progress in `core.pipeline_run`."
          },
          "response": []
        },
        {
          "name": "GET /admin/tenants/:slug/pipeline/steps",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/tenants/{{tenantSlug}}/pipeline/steps", "host": ["{{baseUrl}}"], "path": ["admin", "tenants", "{{tenantSlug}}", "pipeline", "steps"] },
            "description": "Lists the routines an admin can trigger individually. Returns `{ steps: [...] }` (the PipelineStep enum values)."
          },
          "response": []
        },
        {
          "name": "POST /admin/tenants/:slug/pipeline/steps/:step",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/tenants/{{tenantSlug}}/pipeline/steps/{{step}}", "host": ["{{baseUrl}}"], "path": ["admin", "tenants", "{{tenantSlug}}", "pipeline", "steps", "{{step}}"] },
            "description": "Runs a single routine IN ISOLATION (the `standalone` flag suppresses its successors, so nothing downstream cascades). New run id per call. `:step` must be one of the values from GET …/pipeline/steps (e.g. `sync-base-product`, `import-competitor-products`); 400 otherwise. Returns `{ pipelineRunId, step }`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin — DLQ",
      "description": "Plan 06 — `src/admin/controllers/dlq.controller.ts`. Inspect and replay messages in `<step>.dlq`.",
      "item": [
        {
          "name": "GET /admin/dlq/:step",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/dlq/{{step}}?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "dlq", "{{step}}"],
              "query": [{ "key": "limit", "value": "50" }]
            },
            "description": "Peek without consuming: basicGet + nack(requeue=true). Returns up to `limit` messages with `{ routingKey, body, redelivered, headers }`. `step` must match `PipelineStep`."
          },
          "response": []
        },
        {
          "name": "POST /admin/dlq/:step/replay",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/dlq/{{step}}/replay?max=100",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "dlq", "{{step}}", "replay"],
              "query": [{ "key": "max", "value": "100" }]
            },
            "description": "Pops up to `max` messages from `<step>.dlq` and re-publishes them to the main exchange with `attempt=1`. Returns `{ replayed }`."
          },
          "response": []
        }
      ]
    }
  ]
}
