{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "noEmit": false,
    "incremental": false,
    "declaration": false,
    "sourceMap": false,
    "removeComments": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "migrations/**/*.ts"],
  "exclude": ["**/*.spec.ts", "node_modules", "dist", "test", "legacy-app", "plans", "arc"]
}
